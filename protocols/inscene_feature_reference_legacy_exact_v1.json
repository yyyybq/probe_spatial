{
  "schema_version": 1,
  "contract": "LEGACY_EXACT_REFERENCE_V1",
  "canonical_temporal_protocol": "inscene_streaming_canonical_v2_obs28_h124",
  "scope": "read_only_feature_reference_overlay",
  "does_not_modify_temporal_protocol": true,
  "byte_level_certification": false,
  "payload_full_read_required": false,
  "payload_copy_required": false,
  "route_namespaces": {
    "streaming": "FEAT_STREAMING_CANONICAL_V2_MIXED_REFERENCE_V1",
    "target": "FEAT_TARGET_CANONICAL_V2_MIXED_REFERENCE_V1"
  },
  "namespace_separation": {
    "seeded_namespaces_are_never_written": true,
    "legacy_paths_are_read_only": true,
    "route_catalog_contains_no_feature_payloads": true,
    "reference_contract_must_be_visible_per_route": true
  },
  "exact_reference_requirements": [
    "canonical_raw_ids_equal_source_raw_ids_in_order",
    "vfm_equal",
    "model_id_equal",
    "layer_equal",
    "timestep_equal",
    "prompt_equal",
    "preprocessing_identity_equal",
    "sidecar_file_and_size_equal",
    "sidecar_tensor_shape_and_dtype_equal",
    "sidecar_and_safetensors_shape_equal_exact_canonical_expected_shape",
    "safetensors_header_shape_dtype_and_offsets_valid",
    "source_exists_as_regular_file"
  ],
  "not_required": [
    "random_seed",
    "extractor_git_commit",
    "extractor_provenance",
    "historical_payload_sha256",
    "recomputed_payload_sha256",
    "payload_copy"
  ],
  "declared_sha_handling": {
    "valid_sha256_is_recorded_if_present": true,
    "declared_sha256_is_not_verified": true,
    "missing_or_invalid_sha256_does_not_block_reference": true
  },
  "fail_closed": {
    "missing_identity_evidence": "REEXTRACT",
    "raw_id_mismatch": "REEXTRACT",
    "missing_source": "REEXTRACT",
    "invalid_safetensors_header": "REEXTRACT",
    "wrong_tensor_shape": "REEXTRACT",
    "unresolved_backend_shape_contract": "PENDING_BACKEND_CANARY",
    "remote_source_without_existence_evidence": "PENDING_REMOTE_GATE"
  }
}
